# Names only. Do not commit real values.
#
# Shooju and EA API credentials use upstream's project .env naming
# (engine.env_config / engine.etl.metadata), so one set of credentials
# serves both projects:
MY_SHOOJU_USERNAME=
MY_SHOOJU_API_KEY=
MY_EA_API_KEY=

# This project's own variables:
UPSTREAM_DIR=       # absolute path to the upstream project
WORKBOOK_ROOT=       # folder holding monthly workbook vintages
